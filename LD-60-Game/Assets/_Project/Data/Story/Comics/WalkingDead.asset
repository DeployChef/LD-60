  m_Script: {fileID: 11500000, guid: d41a8b62c93e47f198a5b2c4e6f01357, type: 3}
  m_Name: WalkingDead
  m_EditorClassIdentifier: LD60.UI::LD60.UI.StoryComicsData
  background: {fileID: 21300000, guid: f528da51ac12f8d469c3eb563e32a7bc, type: 3}
  blocks:
  - image: {fileID: 21300000, guid: c962b5a9e807ef2418c4f5cf4c91c5ed, type: 3}
    subtitle: The stamp came down like an executioner's axe. The last word had been
      spoken, and for once, it was the plain truth.
  - image: {fileID: 21300000, guid: 39a693f234a0ea84491560bb99b3e427, type: 3}
    subtitle: Buddy pushed the old rotary machines past their limit. The pressroom
      roared, firing thousands of fresh papers out into the night.
  - image: {fileID: 21300000, guid: 070218d433375504faa12a16523c4ef7, type: 3}
    subtitle: The city woke up changed. Workers passed the morning issue from hand
      to hand as shock turned to whispers, and whispers grew into a roar.
  - image: {fileID: 21300000, guid: ecd3d8449b19ce647ba594d64fe4a98a, type: 3}
    subtitle: Ten years of lies collapsed in a single morning. A regime built on
      fear finally choked on its own blood.
  - image: {fileID: 21300000, guid: a8e668dfcd17f6d4aaa84661a4962592, type: 3}
    subtitle: The Leader's giant portrait crashed onto the cobblestones in a shower
      of sparks. For the first time in years, the city took a full breath.
  - image: {fileID: 21300000, guid: 5a006ddf00790754092e8751b05a87d9, type: 3}
    subtitle: '"I hate Mondays, Boss," I said quietly. The old man turned his scarred
      face toward the sun and smiled: "At least now, kid, it''s really your paper."'
