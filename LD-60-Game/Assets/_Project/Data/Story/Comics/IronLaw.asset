  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d41a8b62c93e47f198a5b2c4e6f01357, type: 3}
  m_Name: IronLaw
  m_EditorClassIdentifier: LD60.UI::LD60.UI.StoryComicsData
  background: {fileID: 2508105488073898482, guid: f528da51ac12f8d469c3eb563e32a7bc, type: 3}
  blocks:
  - image: {fileID: 0}
    subtitle: "My hand trembled, but the stamp came down square. Fear won out over conscience, and the paper sided with the men holding the guns."
  - image: {fileID: 0}
    subtitle: "The man in the mask realized too late. The trap snapped shut the exact moment the press inked the government's martial law decree."
  - image: {fileID: 0}
    subtitle: "This time, they didn't miss. The living dead man went back where he came from: an unmarked pit in the wet earth."
  - image: {fileID: 0}
    subtitle: "The decree did its job. The city locked its doors and drew its curtains tight. The uprising died before it could even begin."
  - image: {fileID: 0}
    subtitle: "\"Good call, Editor,\" the officer said, clapping a heavy hand on my shoulder. \"The state needs loyal pens. This chair is yours for life.\""
  - image: {fileID: 0}
    subtitle: "You got everything: safety, money, official favor. Yet every night, in every dark windowpane, the shattered mask of your old mentor stares back at you."
