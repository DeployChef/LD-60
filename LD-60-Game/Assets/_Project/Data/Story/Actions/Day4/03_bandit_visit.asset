    value: 0
  - kind: 2
    emotion: threat
    text: Run this notice today and fifty coins stay on your blotter. Turn me down,
      and you'll be walking home by the canal in the dark.
    giftId: 
    amount: 1
    optionA: Leave the fifty.
    optionB: Find another paper.
